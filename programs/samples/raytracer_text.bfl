// raytracer_text.bfl - the raytracer, drawn as text in an ordinary terminal.
//
// The same scene as raytracer.bfl (four reflective spheres on a checkerboard,
// two coloured lamps, soft shadows, the camera circling), rendered at 79 x 22
// character cells and written to the terminal with '.': each cell's brightness
// picks a character from the ramp  .:-=+*#%@  and its colour, at full brightness, picks one of the
// 256 ANSI terminal colours (ESC[38;5;Nm, sent only when it changes).  Every
// frame homes the cursor and redraws in place.  Set COLOUR to 0 for plain ASCII.
//
// Terminal cells are about twice as tall as they are wide, so a row steps the
// ray twice as far as a column does.  At this resolution detail turns into
// noise, so the scene is tuned for text: a night sky, a quiet checkerboard,
// less mirror-like spheres and a closer camera.  The fixed-point renderer is
// described in raytracer.bfl.  A frame takes about a second.
//
//     bf programs\samples\raytracer_text.bfl      in a terminal of at least 80 x 24;
//                                                 Ctrl+C stops
//     bfui programs\samples\raytracer_text.bfl    F5 runs it, Shift+F5 stops

heap 16384;

const COLOUR = 1;           // 0: plain ASCII, no escape codes for colour
const W = 79;               // picture size in character cells (one column spare: no auto-wrap)
const H = 22;
const CXC = 39;             // centre of the picture
const CYC = 11;
const PIXX = 52;            // ray step per column, Q12 (about 53 degrees across)
const PIXY = 104;           // ray step per row: cells are twice as tall as wide
const NS = 4;               // spheres
const AMB = 48;             // ambient light, 0..256
const ORBIT = 1408;         // camera distance from the centre, Q8 (5.5 units)
const CAMY = 461;           // camera height (1.8 units)
const TY = 154;             // height it looks at (0.6 units)
const STEP = 6;             // degrees the camera moves per frame
const LS = 425984;          // floor light strength: 6.5 square units, Q16
const FAR = 15000;          // floor hits further than this (Q8) are lost in the haze
const HAZE_R = 34;          // horizon colour (a night sky: the lit scene stands out); darker above
const HAZE_G = 40;
const HAZE_B = 66;

heap byte lmap[12288];      // floor light map: 64 x 64 cells of a quarter unit, RGB

// ---- the scene ----------------------------------------------------------------------------
long scx[4];   long scy[4];   long scz[4];      // sphere centres, Q8
long srad[4];  long srr[4];                     // radius (Q8) and radius squared (Q16)
long skn[4];                                    // N = (P - C) * skn >> 8 is the unit normal in Q12
int  scr[4];   int  scg[4];   int  scb[4];      // colour
int  sref[4];                                   // reflectivity, 0..128

long lpx[2];   long lpy[2];   long lpz[2];      // lamp positions, Q8
int  lcr[2];   int  lcg[2];   int  lcb[2];      // lamp colours

int  ldx[8];   int  ldy[8];   int  ldz[8];      // unit vector from sphere s to lamp l (Q7), index s*2+l
int  hvx[8];   int  hvy[8];   int  hvz[8];      // half vectors for the highlights, per frame
long shin[4];  long shout[4];                   // shadow band per sphere: inner and outer radius squared, Q16
string ramp = " .:-=+*#%@";                     // dark to bright

// ---- per frame ---------------------------------------------------------------------------
long sc[4];                                     // per sphere: c = (|O - C|^2 - r^2) >> 8
long socdu[4]; long socdv[4]; long socd0[4];    // (O - C) . du, . dv, . d0  (Q20)
byte bvis[4]; byte bx0[4]; byte bx1[4]; byte by0[4]; byte by1[4];   // screen boxes
long brow[4];                                   // (O - C) . d at the start of the row
byte lvis[2]; byte lcol[2]; byte lrow[2];       // where the lamps appear this frame

// The working scalars.  The compiler lays out these declarations (everything up
// to the first statement) by how often they are used, so the busiest end up
// next to the temporaries and arithmetic travels a few cells, not hundreds.
long ox;  long oy;  long oz;                    // camera position, Q8
long fx;  long fy;  long fz;                    // forward, Q12
long rx;  long rz;                              // right (its y is 0), Q12
long ux;  long uy;  long uz;                    // up, Q12
long dux; long duz;                             // ray step per column
long dvx; long dvy; long dvz;                   // ray step per row
long d0x; long d0y; long d0z;                   // ray through the top left cell

// results passed between procedures
int  cr;  int cg;  int cb;                      // the colour being worked out
long nx;  long ny; long nz;                     // the normal at the last sphere hit, Q12
byte tcol = 0;                                  // the terminal's current colour (0: default)


// ---- maths --------------------------------------------------------------------------------
// Sine of whole degrees times 1024 (Bhaskara I's formula, error under 0.2%).
proc int sin1024(word deg) {
    deg = deg % 360;
    byte neg = 0;
    if (deg >= 180) { deg -= 180; neg = 1; }
    long p = long(deg) * (180 - deg);
    int s = int((4096 * p) / (40500 - p));
    if (neg) { return -s; }
    return s;
}

// Square root of a non-negative 32-bit value: a power-of-four bound, then Newton.
proc long isqrt(long v) {
    if (v <= 0) { return 0; }
    long bit = 1073741824;
    long root = 32768;
    while ((bit >> 8) > v) { bit = bit >> 8; root = root >> 4; }
    while (bit > v) { bit = bit >> 2; root = root >> 1; }
    long g = root + (root >> 1);          // root <= sqrt(v) < 2 root
    byte step;
    for (step = 0; step < 3; step++) { g = (g + v / g) >> 1; }     // one division in the code, not three
    return g;
}

proc word millis() {                  // 16 bits: differences are right for anything under 65 s
    pulse TICK_LATCH;
    return word(TICKS1) * 256 + TICKS0;
}

// ---- colours ------------------------------------------------------------------------------
proc sky(long dy) {                   // by the ray's height: the haze at the horizon, dark within a few degrees
    long up = dy >> 1;
    if (up < 0) { up = 0; }
    if (up > 128) { up = 128; }
    int u = int(up);
    cr = HAZE_R + (((5 - HAZE_R) * u) >> 7);
    cg = HAZE_G + (((8 - HAZE_G) * u) >> 7);
    cb = HAZE_B + (((25 - HAZE_B) * u) >> 7);
}

// Blend the colour towards the horizon haze; f is 0..128.
proc haze(int f) {
    cr = cr + (((HAZE_R - cr) * f) >> 7);
    cg = cg + (((HAZE_G - cg) * f) >> 7);
    cb = cb + (((HAZE_B - cb) * f) >> 7);
}

// The floor at quarter-unit cell (qx, qz): from the light map, or unlit tiles beyond it.
proc floor_colour(int qx, int qz) {
    int ix = qx + 32;
    int iz = qz + 32;
    if (ix >= 0 && ix < 64 && iz >= 0 && iz < 64) {
        word i = (word(iz) * 64 + word(ix)) * 3;
        cr = lmap[i];
        cg = lmap[i + 1];
        cb = lmap[i + 2];
    } else if (((qx >> 2) ^ (qz >> 2)) & 1) {
        cr = 34; cg = 33; cb = 32;
    } else {
        cr = 5; cg = 6; cb = 8;
    }
}

// Switch the terminal's foreground colour (an xterm 256-colour index) if it differs.
proc colour(byte c) {
    if (COLOUR && c != tcol) {
        out "\e[38;5;";
        print c;
        out 'm';
        tcol = c;
    }
}

// The nearest of the six levels (0, 95, 135, 175, 215, 255) of the xterm colour cube.
proc byte level(int v) {
    if (v < 48) { return 0; }
    int k = (v - 35) / 40;
    if (k > 5) { k = 5; }
    return byte(k);
}

// Write the colour as one character cell: brightness picks the character from
// the ramp (mid-tones lifted so shading spans more of it), and the colour itself
// picks the nearest terminal colour, from the grey ramp when it is nearly grey.
proc emit() {
    int rv = cr;  int gv = cg;  int bv = cb;
    if (rv < 0) { rv = 0; } if (rv > 255) { rv = 255; }
    if (gv < 0) { gv = 0; } if (gv > 255) { gv = 255; }
    if (bv < 0) { bv = 0; } if (bv > 255) { bv = 255; }
    word lum = (word(rv) * 77 + word(gv) * 150 + word(bv) * 29) >> 8;      // 0..255
    word lc = lum + ((lum * (255 - lum)) >> 8);                             // 128 -> 192
    byte ch = ramp[(lc * 9 + 128) >> 8];
    if (ch != ' ') {
        int hi = rv;  int lo = rv;
        if (gv > hi) { hi = gv; } if (gv < lo) { lo = gv; }
        if (bv > hi) { hi = bv; } if (bv < lo) { lo = bv; }
        if (hi - lo < 24) {
            colour(232 + byte((lum * 23) / 255));                           // 24 greys
        } else {
            colour(16 + level(rv) * 36 + level(gv) * 6 + level(bv));
        }
    }
    out ch;
}

// ---- spheres ------------------------------------------------------------------------------
// Diffuse and specular light on sphere s at P; leaves the colour in cr, cg, cb
// and the unit normal (Q12) in nx, ny, nz.
proc light_sphere(byte s, long px, long py, long pz) {
    long k = skn[s];
    nx = ((px - scx[s]) * k) >> 8;
    ny = ((py - scy[s]) * k) >> 8;
    nz = ((pz - scz[s]) * k) >> 8;
    int n7x = int(nx >> 5);
    int n7y = int(ny >> 5);
    int n7z = int(nz >> 5);
    word lr = AMB;  word lg = AMB;  word lb = AMB;
    word spr = 0;   word spg = 0;   word spb = 0;
    byte l;
    for (l = 0; l < 2; l++) {
        byte i = s * 2 + l;
        int ndl = n7x * ldx[i] + n7y * ldy[i] + n7z * ldz[i];         // Q14
        if (ndl > 0) {
            word dif = word(ndl >> 6);                                // 0..256
            lr += (dif * word(lcr[l])) >> 8;
            lg += (dif * word(lcg[l])) >> 8;
            lb += (dif * word(lcb[l])) >> 8;
            int ndh = n7x * hvx[i] + n7y * hvy[i] + n7z * hvz[i];
            if (ndh > 0) {
                word sp = word(ndh >> 6);
                if (sp > 255) { sp = 255; }
                sp = (sp * sp) >> 8;                                  // a power of 32
                sp = (sp * sp) >> 8;
                sp = (sp * sp) >> 8;
                sp = (sp * sp) >> 8;
                sp = (sp * sp) >> 8;
                spr += (sp * word(lcr[l])) >> 8;
                spg += (sp * word(lcg[l])) >> 8;
                spb += (sp * word(lcb[l])) >> 8;
            }
        }
    }
    if (lr > 255) { lr = 255; }
    if (lg > 255) { lg = 255; }
    if (lb > 255) { lb = 255; }
    cr = int((word(scr[s]) * lr) >> 8) + int(spr);
    cg = int((word(scg[s]) * lg) >> 8) + int(spg);
    cb = int((word(scb[s]) * lb) >> 8) + int(spb);
}

// The colour seen along a reflected ray from P on sphere skip (direction Q12, a = its length squared Q8).
proc reflection(byte skip, long px, long py, long pz, long qx, long qy, long qz, long a) {
    byte hit = 255;
    long best = 2000000000;
    byte s;
    for (s = 0; s < NS; s++) {
        if (s != skip) {
            long ocx = px - scx[s];
            long ocy = py - scy[s];
            long ocz = pz - scz[s];
            long b = (ocx * qx + ocy * qy + ocz * qz) >> 12;
            if (b < 0) {
                long c = (ocx * ocx + ocy * ocy + ocz * ocz - srr[s]) >> 8;
                long disc = b * b - a * c;
                if (disc > 0) {
                    long t = ((-b - isqrt(disc)) << 8) / a;
                    if (t > 0 && t < best) { best = t; hit = s; }
                }
            }
        }
    }
    if (hit != 255) {
        light_sphere(hit, px + ((best * qx) >> 12), py + ((best * qy) >> 12), pz + ((best * qz) >> 12));
    } else if (qy < 0) {
        long tf = ((-py) << 12) / qy;
        if (tf > FAR) {
            cr = HAZE_R; cg = HAZE_G; cb = HAZE_B;
        } else {
            long hx = px + ((tf * qx) >> 12);
            long hz = pz + ((tf * qz) >> 12);
            floor_colour(int(hx >> 6), int(hz >> 6));
        }
    } else {
        sky(qy);
    }
}

// ---- setting up ---------------------------------------------------------------------------
// Directions from each sphere to each lamp, and each sphere's shadow band.
proc prepare_lights() {
    byte s;
    for (s = 0; s < NS; s++) {
        byte l;
        for (l = 0; l < 2; l++) {
            byte i = s * 2 + l;
            long vx = lpx[l] - scx[s];
            long vy = lpy[l] - scy[s];
            long vz = lpz[l] - scz[s];
            long len = isqrt(vx * vx + vy * vy + vz * vz);
            ldx[i] = int((vx * 128) / len);
            ldy[i] = int((vy * 128) / len);
            ldz[i] = int((vz * 128) / len);
        }
        // a line passing closer than 0.85 r to the centre is in full shadow, beyond
        // 1.15 r fully lit, and in between partly: a soft edge
        long rin = (srad[s] * 218) >> 8;
        long rout = (srad[s] * 294) >> 8;
        shin[s] = rin * rin;
        shout[s] = rout * rout;
    }
}

// The floor's light map (it does not depend on the camera), with a progress bar.
proc build_light_map() {
    byte iz;
    for (iz = 0; iz < 64; iz++) {
        if ((iz & 3) == 0) { out '#'; }
        byte ix;
        for (ix = 0; ix < 64; ix++) {
            long px = (long(ix) - 32) * 64 + 32;
            long pz = (long(iz) - 32) * 64 + 32;
            word lr = AMB;  word lg = AMB;  word lb = AMB;
            byte l;
            for (l = 0; l < 2; l++) {
                long vx = lpx[l] - px;
                long vy = lpy[l];
                long vz = lpz[l] - pz;
                long d2 = vx * vx + vy * vy + vz * vz;              // Q16
                long dist = isqrt(d2);                              // Q8
                long cosq = (vy << 8) / dist;                       // Q8
                long inten = (cosq * LS) / d2;                      // falls off with the square of the distance
                long wx = (vx << 8) / dist;                         // unit vector to the lamp, Q8
                long wy = (vy << 8) / dist;
                long wz = (vz << 8) / dist;
                // shadows: how close does the line to the lamp pass each sphere's centre?
                byte s;
                for (s = 0; s < NS; s++) {
                    long ocx = scx[s] - px;
                    long ocy = scy[s];
                    long ocz = scz[s] - pz;
                    long along = (ocx * wx + ocy * wy + ocz * wz) >> 8;     // Q8
                    if (along > 0 && along < dist) {
                        long m2 = ocx * ocx + ocy * ocy + ocz * ocz - along * along;   // Q16
                        if (m2 < shin[s]) {
                            inten = 0;
                        } else if (m2 < shout[s]) {
                            inten = (inten * (((m2 - shin[s]) << 8) / (shout[s] - shin[s]))) >> 8;
                        }
                    }
                }
                if (inten > 255) { inten = 255; }                  // keeps w * colour within a word
                word w = word(inten);
                lr += (w * word(lcr[l])) >> 8;
                lg += (w * word(lcg[l])) >> 8;
                lb += (w * word(lcb[l])) >> 8;
            }
            if (lr > 255) { lr = 255; }
            if (lg > 255) { lg = 255; }
            if (lb > 255) { lb = 255; }
            // a quiet checkerboard, so the spheres stand out at this resolution
            word tr = 22;  word tg = 24;  word tb = 32;              // dark tile
            if (((ix >> 2) ^ (iz >> 2)) & 1) { tr = 150; tg = 146; tb = 138; }
            word i = (word(iz) * 64 + word(ix)) * 3;
            lmap[i] = byte((tr * lr) >> 8);
            lmap[i + 1] = byte((tg * lg) >> 8);
            lmap[i + 2] = byte((tb * lb) >> 8);
        }
    }
}

// Camera on its circle at angle ang, looking at the middle of the scene.
proc place_camera(word ang) {
    long sn = sin1024(ang);
    long cs = sin1024(ang + 90);
    ox = (sn * ORBIT) / 1024;
    oy = CAMY;
    oz = (cs * ORBIT) / 1024;
    long vx = -ox;
    long vy = TY - oy;
    long vz = -oz;
    long len = isqrt(vx * vx + vy * vy + vz * vz);
    fx = (vx * 4096) / len;
    fy = (vy * 4096) / len;
    fz = (vz * 4096) / len;
    long hl = isqrt(fx * fx + fz * fz);
    rx = (-fz * 4096) / hl;
    rz = (fx * 4096) / hl;
    ux = (-rz * fy) >> 12;                  // up = right x forward
    uy = (rz * fx - rx * fz) >> 12;
    uz = (rx * fy) >> 12;
    dux = (rx * PIXX) >> 12;
    duz = (rz * PIXX) >> 12;
    dvx = (-ux * PIXY) >> 12;
    dvy = (-uy * PIXY) >> 12;
    dvz = (-uz * PIXY) >> 12;
    d0x = fx - dux * CXC - dvx * CYC;
    d0y = fy - dvy * CYC;
    d0z = fz - duz * CXC - dvz * CYC;

    // highlights: half way between the way to each lamp and the way back to the camera
    int f7x = int(fx >> 5);
    int f7y = int(fy >> 5);
    int f7z = int(fz >> 5);
    byte i;
    for (i = 0; i < 8; i++) {
        long hx = ldx[i] - f7x;
        long hy = ldy[i] - f7y;
        long hz = ldz[i] - f7z;
        long hlen = isqrt(hx * hx + hy * hy + hz * hz);
        hvx[i] = int((hx * 128) / hlen);
        hvy[i] = int((hy * 128) / hlen);
        hvz[i] = int((hz * 128) / hlen);
    }

    // per sphere: the constant part of the hit test, and a screen box around it
    byte s;
    for (s = 0; s < NS; s++) {
        long ocx = ox - scx[s];
        long ocy = oy - scy[s];
        long ocz = oz - scz[s];
        sc[s] = (ocx * ocx + ocy * ocy + ocz * ocz - srr[s]) >> 8;
        socdu[s] = ocx * dux + ocz * duz;
        socdv[s] = ocx * dvx + ocy * dvy + ocz * dvz;
        socd0[s] = ocx * d0x + ocy * d0y + ocz * d0z;
        long zc = -((ocx * fx + ocy * fy + ocz * fz) >> 12);
        long xc = -((ocx * rx + ocz * rz) >> 12);
        long yc = -((ocx * ux + ocy * uy + ocz * uz) >> 12);
        bvis[s] = 0;
        if (zc > srad[s] + 64) {
            long cxp = CXC + (xc * 4096) / (zc * PIXX);
            long cyp = CYC - (yc * 4096) / (zc * PIXY);
            long rpx = (srad[s] * 4096) / ((zc - srad[s]) * PIXX) + 2;
            long rpy = (srad[s] * 4096) / ((zc - srad[s]) * PIXY) + 2;
            long x0 = cxp - rpx;  long x1 = cxp + rpx;
            long y0 = cyp - rpy;  long y1 = cyp + rpy;
            if (x1 >= 0 && x0 < W && y1 >= 0 && y0 < H) {
                if (x0 < 0) { x0 = 0; }
                if (x1 >= W) { x1 = W - 1; }
                if (y0 < 0) { y0 = 0; }
                if (y1 >= H) { y1 = H - 1; }
                bvis[s] = 1;
                bx0[s] = byte(x0); bx1[s] = byte(x1);
                by0[s] = byte(y0); by1[s] = byte(y1);
            }
        }
    }

    // the lamps: one cell each, if the camera can see them
    byte l;
    for (l = 0; l < 2; l++) {
        lvis[l] = 0;
        long lx = lpx[l] - ox;
        long ly = lpy[l] - oy;
        long lz = lpz[l] - oz;
        long zl = (lx * fx + ly * fy + lz * fz) >> 12;
        if (zl > 128) {
            long xl = (lx * rx + lz * rz) >> 12;
            long yl = (lx * ux + ly * uy + lz * uz) >> 12;
            long sx = CXC + (xl * 4096) / (zl * PIXX);
            long sy = CYC - (yl * 4096) / (zl * PIXY);
            if (sx >= 1 && sx < W - 1 && sy >= 0 && sy < H) {
                lvis[l] = 1;
                lcol[l] = byte(sx);
                lrow[l] = byte(sy);
            }
        }
    }
}

// ---- one frame ----------------------------------------------------------------------------
proc render() {
    long du2 = dux * dux + duz * duz;           // Q24
    byte y;
    for (y = 0; y < H; y++) {
        // the ray at the start of this row, and the quantities that step along it
        long dx = d0x + long(y) * dvx;
        long dy = d0y + long(y) * dvy;          // constant along the row
        long dz = d0z + long(y) * dvz;
        long aa = dx * dx + dy * dy + dz * dz;  // |d|^2, Q24
        long dd = dx * dux + dz * duz;          // d . du
        byte any = 0;
        byte s;
        for (s = 0; s < NS; s++) {
            brow[s] = socd0[s] + long(y) * socdv[s];
            if (bvis[s] && y >= by0[s] && y <= by1[s]) { any = 1; }
        }
        // the floor along this row: one division, then steps
        byte floor = 0;
        long hxr = 0;  long hzr = 0;  long stx = 0;  long stz = 0;
        int fog = 128;
        if (dy < 0) {
            long tf = ((-oy) << 12) / dy;
            if (tf < FAR) {
                floor = 1;
                hxr = (ox << 12) + tf * dx;     // Q20
                hzr = (oz << 12) + tf * dz;
                stx = tf * dux;
                stz = tf * duz;
                long f = (tf - 1536) / 70;
                if (f < 0) { f = 0; }
                if (f > 128) { f = 128; }
                fog = int(f);
            }
        }
        byte x;
        for (x = 0; x < W; x++) {
            // a lamp: a bright star with a glow either side
            byte lampch = 0;
            byte l;
            for (l = 0; l < 2; l++) {
                if (lvis[l] && y == lrow[l]) {
                    byte warm = 229;
                    if (l == 1) { warm = 159; }
                    if (x == lcol[l]) { lampch = '*'; colour(231); }
                    else if (x + 1 == lcol[l] || x == lcol[l] + 1) { lampch = '-'; colour(warm); }
                }
            }
            if (lampch) {
                out lampch;
            } else {
                byte hit = 255;
                long best = 2000000000;
                if (any) {
                    long a = aa >> 16;              // Q8
                    for (s = 0; s < NS; s++) {
                        if (bvis[s] && x >= bx0[s] && x <= bx1[s] && y >= by0[s] && y <= by1[s]) {
                            long b = (brow[s] + long(x) * socdu[s]) >> 12;
                            if (b < 0) {
                                long disc = b * b - a * sc[s];
                                if (disc > 0) {
                                    long t = ((-b - isqrt(disc)) << 8) / a;
                                    if (t > 0 && t < best) { best = t; hit = s; }
                                }
                            }
                        }
                    }
                    if (hit != 255) {
                        long px = ox + ((best * dx) >> 12);
                        long py = oy + ((best * dy) >> 12);
                        long pz = oz + ((best * dz) >> 12);
                        light_sphere(hit, px, py, pz);
                        int own_r = cr;  int own_g = cg;  int own_b = cb;
                        // reflect the ray about the normal and see what it meets
                        long dn = (dx * nx + dy * ny + dz * nz) >> 12;
                        long qx = dx - ((dn * nx) >> 11);
                        long qy = dy - ((dn * ny) >> 11);
                        long qz = dz - ((dn * nz) >> 11);
                        reflection(hit, px, py, pz, qx, qy, qz, a);
                        int k = sref[hit];
                        cr = own_r + (((cr - own_r) * k) >> 7);
                        cg = own_g + (((cg - own_g) * k) >> 7);
                        cb = own_b + (((cb - own_b) * k) >> 7);
                    }
                }
                if (hit == 255) {
                    if (floor) {
                        floor_colour(int(hxr >> 18), int(hzr >> 18));
                        haze(fog);
                    } else if (dy < 0) {
                        cr = HAZE_R; cg = HAZE_G; cb = HAZE_B;
                    } else {
                        sky(dy);
                    }
                }
                emit();
            }
            // step to the next cell
            aa = aa + dd + dd + du2;
            dd = dd + du2;
            dx = dx + dux;
            dz = dz + duz;
            hxr = hxr + stx;
            hzr = hzr + stz;
        }
        out "\r\n";
    }
}

// ---- run ----------------------------------------------------------------------------------
// The scene.  Constant indices make each of these a direct cell write; passing
// the index to a helper procedure would make it a runtime index, which walks the
// array (tens of thousands of commands for each long element written).
scx[0] = 0;     scy[0] = 256;  scz[0] = -102;  srad[0] = 256;  skn[0] = 4096;    // chrome
scr[0] = 200;   scg[0] = 200;  scb[0] = 210;   sref[0] = 72;
scx[1] = 410;   scy[1] = 154;  scz[1] = 230;   srad[1] = 154;  skn[1] = 6809;    // red
scr[1] = 220;   scg[1] = 40;   scb[1] = 40;    sref[1] = 24;
scx[2] = -384;  scy[2] = 179;  scz[2] = 256;   srad[2] = 179;  skn[2] = 5858;    // gold
scr[2] = 230;   scg[2] = 170;  scb[2] = 50;    sref[2] = 32;
scx[3] = 256;   scy[3] = 115;  scz[3] = -563;  srad[3] = 115;  skn[3] = 9118;    // blue
scr[3] = 60;    scg[3] = 100;  scb[3] = 230;   sref[3] = 28;
srr[0] = 65536; srr[1] = 23716; srr[2] = 32041; srr[3] = 13225;                  // radius squared, Q16
// lamps: warm at front left, 2.8 units up; cool at back right, 2.4 units up
lpx[0] = -563;  lpy[0] = 717;  lpz[0] = 512;   lcr[0] = 255; lcg[0] = 220; lcb[0] = 170;
lpx[1] = 666;   lpy[1] = 614;  lpz[1] = -460;  lcr[1] = 140; lcg[1] = 170; lcb[1] = 255;

out "\e[2J\e[H\e[?25l";                           // clear the screen, hide the cursor
print "BFL raytracer: working out the floor's lighting ";
prepare_lights();
build_light_map();

word ang = 30;
word frame = 0;
while (1) {
    word t0 = millis();
    place_camera(ang);
    out "\e[H\e[0m";
    tcol = 0;
    print " BFL raytracer: 4 reflective spheres, 2 lamps, a checkerboard floor            \r\n";
    render();
    if (COLOUR) { out "\e[0m"; tcol = 0; }
    print " frame ", frame, "   camera at ", ang, " degrees   ", millis() - t0, " ms    (Ctrl+C stops)    ";
    frame++;
    ang = (ang + STEP) % 360;
}
